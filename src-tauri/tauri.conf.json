{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "batbelt",
  "version": "1.1.0",
  "identifier": "dev.lucaryholt.batbelt",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  }
}

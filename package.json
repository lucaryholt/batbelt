{
  "name": "batbelt",
  "version": "1.1.0",
  "description": "Modular localhost toolbox: homepage shortcuts, Kubernetes port-forwards, OpenBao secrets, and a GitHub PR inbox",
  "type": "module",
  "bin": {
    "batbelt": "./dist/cli.js"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "DEV=1 PORT=3870 tsx watch src/cli.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "desktop": "npm run build && tauri build",
    "desktop:dev": "npm run build && tauri dev",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^11.9.0",
    "commander": "^13.1.0",
    "hono": "^4.7.5",
    "open": "^10.2.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@tauri-apps/cli": "^2.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.8.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
